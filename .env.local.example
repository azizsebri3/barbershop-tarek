# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://tareksalon.be
# Google Places API (server-side only; enable Places API (New) in Google Cloud)
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=your_google_place_id
# Add the booking URL provided by Salonkee after Tarek's account is activated.
# Leave empty to keep using the site's internal booking form.
NEXT_PUBLIC_SALONKEE_BOOKING_URL=

# Admin session signing: set a unique, random secret of at least 32 bytes.
# Never use the example value in an actual environment.
JWT_SECRET=your_jwt_secret_key_here

# Rescheduling links: use a different random secret of at least 32 bytes.
BOOKING_LINK_SECRET=your_booking_link_secret_here

# Email Configuration (Resend recommended)
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=admin@tareksalon.be

# Push Notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
